       .replace(this.PHONE_REGEX, "[REDACTED_PHONE]")
       .replace(this.AADHAAR_REGEX, "[REDACTED_ID]");
 
+    // Case-sensitive verification: the NL_NAME_REGEXES above carry the "i" flag
+    // so their trigger keywords ("contact", "for", "Farmer", ...) match
+    // regardless of case, but that same flag also lets [A-Z] in the name-capture
+    // group match lowercase letters — so an ordinary lowercase phrase like
+    // "for wheat spray" gets mis-parsed as a capitalized name. Guard against
+    // this by re-checking the actual captured text is genuinely Title Case
+    // before redacting it.
+    const isActuallyTitleCase = (value: string): boolean =>
+      /^[A-Z][a-z]+(?:\s+[A-Z][a-z]+)+$/.test(value);
+
     for (const regex of this.NL_NAME_REGEXES) {
       scrubbed = scrubbed.replace(regex, (match, capturedName) => {
-        if (capturedName && typeof capturedName === "string") {
+        if (
+          capturedName &&
+          typeof capturedName === "string" &&
+          isActuallyTitleCase(capturedName)
+        ) {
           return match.replace(capturedName, "[REDACTED_NAME]");
         }
-        return "[REDACTED_NAME]";
+        return match;
       });
     }
 
