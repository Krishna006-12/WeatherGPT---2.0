# ==============================================================================
# WeatherGPT 2.0 — Environment Variables Template
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deployment Environment ("staging" | "pilot" | "production")
NEXT_PUBLIC_ENVIRONMENT="pilot"

# Upstream Meteorological Provider (Open-Meteo runs free without an API key)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# Google Gemini API Key (Required for AI Copilot, Grounded Weather Briefs & Voice)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Telemetry and Pilot Mode ("true" enables evaluation logging and live accuracy pairing)
NEXT_PUBLIC_PILOT_TELEMETRY_ENABLED="true"

# Optional: Remote PostgreSQL Persistence (Supabase / Neon)
# If omitted, WeatherGPT 2.0 uses high-speed in-memory repository fallbacks.
DATABASE_URL=""
DIRECT_URL=""
