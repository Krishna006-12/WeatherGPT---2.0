# WeatherGPT 2.0 — Environment Variables
# Copy this file to .env.local and fill in the values.
# No real API keys are required for Phase 1.

# Open-Meteo Weather API (Phase 2) — free, no API key required
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com

# News provider (Phase 3)
NEWS_API_KEY=

# AI provider (Phase 5) — Google Gemini API
GEMINI_API_KEY=
AI_API_KEY=

# Live Intelligence sync endpoint protection (min 8 chars)
# When set, POST /api/events/sync requires x-sync-secret header to match.
LIVE_INTEL_SYNC_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
